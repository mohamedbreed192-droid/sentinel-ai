# Generate both secrets before starting. Do not commit .env.
POSTGRES_PASSWORD=replace-with-random-hex-password
DATABASE_URL=postgresql+psycopg://sentinel:replace-with-random-hex-password@postgres:5432/sentinel
REDIS_URL=redis://redis:6379/0
API_TOKEN=replace-with-random-api-token
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
SYNC_JOBS=false
